{
  "name": "booking-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "mobile",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @booking/server",
    "dev:mobile": "npm run start -w @booking/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @booking/server",
    "db:deploy": "npm run db:deploy -w @booking/server",
    "db:migrate": "npm run db:migrate -w @booking/server",
    "db:seed": "npm run db:seed -w @booking/server",
    "db:check": "npm run db:check -w @booking/server",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
