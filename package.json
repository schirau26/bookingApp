{
  "name": "booking-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "mobile",
    "server",
    "admin"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @booking/server",
    "dev:admin": "npm run dev -w @booking/admin",
    "dev:mobile": "npm run start -w @booking/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
