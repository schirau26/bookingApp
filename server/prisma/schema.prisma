// One car wash. Customers book a package. The owner runs the queue.
// Several cars can be washed at once, up to Business.bayCount.
// Service photos are a single imageUrl.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum VehicleSize {
  HATCHBACK
  SEDAN
  SUV
  BAKKIE
  VAN
}

enum BookingStatus {
  CONFIRMED
  ARRIVED
  WASHING
  READY
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum ReviewReportStatus {
  OPEN
  DISMISSED
  RESOLVED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_CANCELLATION
  BOOKING_REMINDER
  BOOKING_RESCHEDULED
  CAR_READY
  NEW_REVIEW
  REVIEW_REPLY
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  fullName        String
  phone           String?    @db.VarChar(32)
  profileImageUrl String?    @db.VarChar(2048)
  role            Role
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  ownedBusinesses Business[]
  bookings        Booking[]
  reviews         Review[]
  reviewReports   ReviewReport[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]

  @@index([role])
  @@index([status])
}

model Business {
  id                     String   @id @default(cuid())
  ownerId                String
  name                   String
  description            String   @db.Text
  address                String   @db.VarChar(255)
  phone                  String   @db.VarChar(32)
  phoneContactName       String   @db.VarChar(80)
  secondaryContactName   String   @db.VarChar(80)
  secondaryPhone         String   @db.VarChar(32)
  email                  String
  logoUrl                String?  @db.VarChar(2048)
  bayCount               Int      @default(1)
  averageRating          Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount            Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  owner        User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  services     Service[]
  workingHours BusinessWorkingHour[]
  photos       BusinessPhoto[]
  bookings     Booking[]
  reviews      Review[]

  @@index([name])
}

model BusinessPhoto {
  id         String   @id @default(cuid())
  businessId String
  url        String   @db.VarChar(2048)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
}

model BusinessWorkingHour {
  id         String    @id @default(cuid())
  businessId String
  dayOfWeek  DayOfWeek
  isClosed   Boolean   @default(false)
  // HH:mm. Null only when the day is closed.
  openTime   String?   @db.VarChar(5)
  closeTime  String?   @db.VarChar(5)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String   @db.Text
  imageUrl    String?  @db.VarChar(2048)
  icon        String   @default("car-sport-outline") @db.VarChar(64)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  prices   ServicePrice[]
  bookings Booking[]

  @@index([businessId, isActive])
  @@index([name])
}

model ServicePrice {
  id              String      @id @default(cuid())
  serviceId       String
  vehicleSize     VehicleSize
  price           Decimal     @db.Decimal(10, 2)
  durationMinutes Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, vehicleSize])
}

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  businessId      String
  serviceId       String
  startsAt        DateTime
  endsAt          DateTime
  customerName    String
  customerPhone   String        @db.VarChar(32)
  customerEmail   String
  note            String?       @db.Text
  vehicleSize     VehicleSize
  registration    String        @db.VarChar(32)
  make            String?       @db.VarChar(80)
  color           String?       @db.VarChar(40)
  price           Decimal       @db.Decimal(10, 2)
  durationMinutes Int
  status          BookingStatus @default(CONFIRMED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer      User           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  review        Review?
  invoice       Invoice?
  notifications Notification[]

  // Availability counts overlaps for this wash. MySQL cannot exclude
  // overlapping ranges, so booking creation locks the wash row.
  @@index([businessId, startsAt])
  @@index([customerId, startsAt])
  @@index([status])
}

model Invoice {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  number        String        @unique @db.VarChar(32)
  issuedAt      DateTime      @default(now())
  customerName  String
  customerPhone String        @db.VarChar(32)
  customerEmail String
  registration  String        @db.VarChar(32)
  vehicleSize   VehicleSize
  packageName   String
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(UNPAID)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  bookingId  String   @unique
  rating     Int
  body       String   @db.Text
  replyBody  String?  @db.Text
  repliedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  photos        ReviewPhoto[]
  reports       ReviewReport[]
  notifications Notification[]

  @@index([businessId, createdAt])
}

model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  url       String   @db.VarChar(2048)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReviewReport {
  id         String             @id @default(cuid())
  reviewId   String
  reporterId String
  reason     String             @db.Text
  status     ReviewReportStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([reviewId, reporterId])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  bookingId String?
  reviewId  String?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  review  Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
}
